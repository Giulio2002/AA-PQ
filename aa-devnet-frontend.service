[Unit]
Description=Kurtosis AA devnet frontend
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kurtosis-aa-devnet/frontend
Environment=PORT=3000
Environment=RPC_URL=http://127.0.0.1:32773
Environment=BUNDLER_URL=http://127.0.0.1:4337
Environment=ENTRY_POINT=0x433709009B8330FDa32311DF1C2AFA402eD8D009
Environment=FACTORY_ADDRESS=0x610178dA211FEF7D417bC0e6FeD39F05609AD788
Environment=FAUCET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ExecStart=/usr/bin/node /opt/kurtosis-aa-devnet/frontend/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
